{
  "name": "breakdex-flutter",
  "version": "1.0.0",
  "description": "Breakdex is a pocket video database for dance moves, combos, and spaced-repetition review. The app combines a move library, combo builder, video editing, deck-based practice, and review analytics in one Flutter app with native iOS bridges for media workflows.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "private": true,
  "scripts": {
    "prepare": "husky",
    "release:dry-run": "semantic-release --dry-run",
    "release:sync-docs": "node scripts/update_release_metadata.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stussysenik/breakdex-flutter.git"
  },
  "keywords": [],
  "author": "",
