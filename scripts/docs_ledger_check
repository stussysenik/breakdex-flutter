#!/usr/bin/env node
// docs_ledger_check — docs↔code freshness gate for the engineering manual.
//
// For each verified manual chapter, diff `verified..HEAD` restricted to that
// chapter's `watches:` globs, using git plumbing only (no network, no model).
// A chapter is STALE when any watched path changed since its `verified` commit.
//
//   node scripts/docs_ledger_check          # human report; exit 1 if any stale
//   node scripts/docs_ledger_check --json    # machine-readable work orders
//
// Chapters with status != 'verified', a null `verified`, or empty `watches`
// are not claims about current code and are skipped. See docs/manual/12-meta.mdx.

'use strict';
const fs = require('fs');
const path = require('path');
const { execFileSync } = require('child_process');

const MANUAL_DIR = 'docs/manual';
const jsonMode = process.argv.includes('--json');

function git(args) {
  return execFileSync('git', args, { encoding: 'utf8' });
}

// Minimal, dependency-free parser for the controlled frontmatter subset we author:
// `key: value` scalars and a `watches:` list of `- glob` items (or `watches: []`).
function parseFrontmatter(text) {
  const m = text.match(/^---\n([\s\S]*?)\n---\n/);
  if (!m) return null;
  const lines = m[1].split('\n');
  const fm = { watches: [] };
  let inWatches = false;
  for (const raw of lines) {
    const listItem = raw.match(/^\s*-\s+(.*)$/);
    if (inWatches && listItem) {
      fm.watches.push(listItem[1].trim());
      continue;
    }
    const kv = raw.match(/^([A-Za-z_]+):\s*(.*)$/);
    if (!kv) continue;
    const [, key, valRaw] = kv;
    inWatches = key === 'watches';
    const val = valRaw.trim();
    if (key === 'watches') {
      if (val === '[]' || val === '') fm.watches = [];
      // otherwise items follow on subsequent `- ` lines
    } else {
      fm[key] = val === 'null' || val === '' ? null : val.replace(/^["']|["']$/g, '');
    }
  }
  return fm;
}

function chapters() {
  return fs.readdirSync(MANUAL_DIR)
    .filter((f) => f.endsWith('.mdx'))
    .sort()
    .map((f) => {
      const file = path.join(MANUAL_DIR, f);
      const fm = parseFrontmatter(fs.readFileSync(file, 'utf8'));
      return fm ? { file, name: fm.name || f, ...fm } : null;
    })
    .filter(Boolean);
}

// A watched path becomes a git glob-magic pathspec so `**` and `*` behave like
// shell globs regardless of git's default (non-pathname) fnmatch.
const toPathspec = (w) => `:(glob)${w}`;

function changedFiles(verified, watches) {
  const args = ['diff', '--name-only', `${verified}`, 'HEAD', '--', ...watches.map(toPathspec)];
  return git(args).split('\n').map((s) => s.trim()).filter(Boolean);
}

function diffStat(verified, watches) {
  const args = ['diff', '--stat', `${verified}`, 'HEAD', '--', ...watches.map(toPathspec)];
  return git(args).trimEnd();
}

const stale = [];
const errors = [];
for (const ch of chapters()) {
  if (ch.status !== 'verified') continue;      // stub/draft: not a claim yet
  if (!ch.verified) continue;                  // no baseline commit
  if (!ch.watches || ch.watches.length === 0) continue; // normative; nothing to watch
  try {
    const changed = changedFiles(ch.verified, ch.watches);
    if (changed.length) {
      stale.push({
        chapter: ch.name,
        file: ch.file,
        watches: ch.watches,
        verified: ch.verified,
        changed_files: changed,
        diff_stat: diffStat(ch.verified, ch.watches),
      });
    }
  } catch (e) {
    errors.push({ chapter: ch.name, file: ch.file, verified: ch.verified, error: String(e.message || e).split('\n')[0] });
  }
}

if (jsonMode) {
  process.stdout.write(JSON.stringify({ stale, errors }, null, 2) + '\n');
} else {
  if (errors.length) {
    console.error('⚠  docs ledger: could not diff these chapters (bad `verified` commit?):');
    for (const e of errors) console.error(`   ${e.chapter} (${e.file}) @ ${e.verified}: ${e.error}`);
  }
  if (stale.length === 0 && errors.length === 0) {
    console.log('✅ docs ledger: all verified chapters current with their watched paths.');
  } else if (stale.length) {
    console.error(`❌ docs ledger: ${stale.length} stale chapter(s) — watched code changed since \`verified\`:`);
    for (const s of stale) {
      console.error(`\n   ${s.chapter}  (${s.file}, verified ${s.verified})`);
      for (const f of s.changed_files) console.error(`      ~ ${f}`);
    }
    console.error(`\n   Re-check each chapter against HEAD, then bump its \`verified:\` frontmatter.`);
    console.error(`   Work orders: node scripts/docs_ledger_check --json`);
  }
}

process.exit(stale.length || errors.length ? 1 : 0);
