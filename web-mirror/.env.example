# ── Breakdex Web Mirror — environment template ───────────────────────────────
# Copy to .env.local and fill in. NONE of these are committed (.gitignore).
# Firebase web config + OAuth client ID are public-by-design client values, but
# we still inject them via env so the repo carries no live configuration.

# Firebase Web app config (Firebase console → Project settings → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=breakdex-flutter.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=breakdex-flutter
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=499240019967

# Comma-separated list of allowed owner emails. Anyone signing in with an email
# NOT on this list is denied before any Drive request is made.
NEXT_PUBLIC_OWNER_ALLOWLIST=itsmxzou@gmail.com

# Drive OAuth scope. drive.file (default) sees only files this project created
# (the Breakdex folder). Fallback: https://www.googleapis.com/auth/drive.readonly
NEXT_PUBLIC_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
