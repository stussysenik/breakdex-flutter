(ns breakdex.dop.atom
  (:require [cljd.core :as c]))

;; Simple atom-based state management using Dart proxies

(def GlobalState (c/JsProxy ._new))

;; Create a new atom
(defn atom [init-val]
  (let [a (c/JsProxy ._new)]
    (c/set! a :val init-val)
    a))

;; Get value from atom
(defn get-val [a]
  (c/get a :val))

;; Set value
(defn set-val! [a v]
  (c/set! a :val v))

;; swap! - update atom with function
(defn swap! [a f]
  (let [old (get-val a)
        new-val (f old)]
    (set-val! a new-val)
    new-val))

;; reset! - set atom directly  
(defn reset! [a v]
  (set-val! a v))

(comment
  
  ;; Example usage:
  (let [my-atom (atom 0)]
    (swap! my-atom inc)
    (get-val my-atom)))