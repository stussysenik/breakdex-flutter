(ns breakdex.hiccup.flutter
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]))

;; ============================================================
;; Hiccup-style Flutter Widget Factory
;; Maps Clojure vectors to Flutter widgets
;; Pattern: [:widget-type {:prop "value"} "content"]
;; ============================================================

;; Text widget - simplified without style for now
(defn text
  [content]
  (m/Text (str content)))

;; Elevated button
(defn elevated-button
  ([label]
   (m/ElevatedButton
     :onPressed nil
     :child (m/Text (str label))))
  ([opts label]
   (m/ElevatedButton
     :onPressed (:onPressed opts)
     :child (m/Text (str label)))))

;; Column
(defn column
  ([children]
   (m/Column :children (vec children)))
  ([opts children]
   (m/Column
     :mainAxisAlignment (or (:mainAxisAlignment opts) m/MainAxisAlignment/start)
     :crossAxisAlignment (or (:crossAxisAlignment opts) m/CrossAxisAlignment/center)
     :children (vec children))))

;; Row
(defn row
  ([children]
   (m/Row :children (vec children)))
  ([opts children]
   (m/Row
     :mainAxisAlignment (or (:mainAxisAlignment opts) m/MainAxisAlignment/start)
     :crossAxisAlignment (or (:crossAxisAlignment opts) m/CrossAxisAlignment/center)
     :children (vec children))))

;; Scaffold
(defn scaffold
  ([body]
   (m/Scaffold :body body))
  ([opts body]
   (m/Scaffold
     :appBar (:appBar opts)
     :body body
     :floatingActionButton (:floatingActionButton opts))))

;; AppBar
(defn appbar
  ([title]
   (m/AppBar :title (m/Text (str title))))
  ([opts title]
   (m/AppBar
     :title (m/Text (str title))
     :backgroundColor (:backgroundColor opts)
     :elevation (:elevation opts))))

;; Center
(defn center
  ([child]
   (m/Center :child child)))

;; Card
(defn card
  ([child]
   (m/Card :child child))
  ([opts child]
   (m/Card
     :child child
     :elevation (:elevation opts)
     :margin (:margin opts))))

;; ============================================================
;; Generic hiccup parser
;; [:widget-type {:props} child1 child2 ...]
;; ============================================================

(defn parse
  [v]
  (let [tag (first v)
        opts (second v)
        kids (rest (rest v))]
    (case tag
      :text (text (first kids) (when (map? opts) opts))
      :elevated-button (elevated-button opts (first kids))
      :column (column opts (mapv parse kids))
      :row (row opts (mapv parse kids))
      :scaffold (scaffold opts (parse (first kids)))
      :appbar (appbar opts (first kids))
      :center (center (parse (first kids)))
      :card (card opts (parse (first kids))))
    (m/Text (str v))))

;; ============================================================
;; Example usage with f/run
;; ============================================================

(comment

  ;; Direct factory usage
  (text "Hello World")
  (text "Styled" {:color m/Colors/blue :fontSize 18.0})
  (elevated-button {:onPressed #(do-something)} "Click me")
  (column [{:mainAxisAlignment m/MainAxisAlignment/center}
           (text "Item 1")
           (text "Item 2")])

  ;; With f/run - entry point
  (f/run
    (m/MaterialApp
      :home (scaffold
             {:appBar (appbar "My App")}
             (center
               (column
                 [{:mainAxisAlignment m/MainAxisAlignment/center}
                  (text "Welcome!")
                  (elevated-button {:onPressed #(println "Pressed!")} "Press Me")])))))

  ;; Hiccup vector syntax
  (parse [:scaffold {}
           [:center {}
             [:column {}
              [:text {} "Hello"]
              [:elevated-button {:onPressed #(println "ok")} "Click"]]]])

  )