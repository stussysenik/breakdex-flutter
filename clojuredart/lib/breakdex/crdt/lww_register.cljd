(ns breakdex.crdt.lww-register
  (:require [cljd.core :as c]))

;; ============================================================
;; LWW Register (Last-Writer-Wins Register)
;; A CRDT that resolves conflicts using timestamps
;; The value with the later timestamp always wins
;; ============================================================

;; Registry for storing register values
(def- ^:private RegisterStore (atom {}))

(defn- get-register [id]
  (get @RegisterStore id))

(defn- set-register! [id val]
  (swap! RegisterStore assoc id val))

;; ============================================================
;; LWW Register Record
;; Contains:
;;   - :value  - the actual value
;;   - :ts     - timestamp (higher wins)
;;   - :id     - unique identifier
;; ============================================================

(defrecord LWWRegister [id value ts])

(defn- make-register
  "Creates a new LWW register with value and timestamp"
  [value ts]
  (let [id (c/gen-id)]
    (->LWWRegister id value ts)))

;; ============================================================
;; Factory Functions
;; ============================================================

(defn lww-register
  "Creates a new LWW register with value and timestamp.
   Higher timestamp wins in conflicts.
   Example: (lww-register \"Windmill\" 1000)"
  [value ts]
  (make-register value ts))

(defn register
  "Creates an LWW register with current timestamp.
   Uses Dart DateTime.now().millisecondsSinceEpoch"
  ([value]
   (let [ts (. DateTime :now (millisecondsSinceEpoch))]
     (make-register value ts)))
  ([value ts]
   (make-register value ts)))

(defn empty-register
  "Creates an empty LWW register with timestamp 0"
  []
  (make-register nil 0))

;; ============================================================
;; Accessor Functions
;; ============================================================

(defn value
  "Gets the value from an LWW register"
  [reg]
  (. reg value))

(defn timestamp
  "Gets the timestamp from an LWW register"
  [reg]
  (. reg ts))

(defn register-id
  "Gets the unique identifier from an LWW register"
  [reg]
  (. reg id))

(defn timestamped-value
  "Gets the pair [timestamp value] from register"
  [reg]
  [(. reg ts) (. reg value)])

;; ============================================================
;; Mutation Functions
;; ============================================================

(defn update-register
  "Updates register with new value and timestamp.
   Returns new register (immutable)."
  [reg new-value new-ts]
  (make-register new-value new-ts))

(defn assign
  "Assigns new value, using current timestamp.
   Creates new register (immutable)."
  [reg new-value]
  (let [ts (. DateTime :now (millisecondsSinceEpoch))]
    (make-register new-value ts)))

;; ============================================================
;; Merge Function
;; Returns register with later timestamp
;; ============================================================

(defn merge
  "Merges two LWW registers.
   Later timestamp wins.
   Returns the winning register.
   Example: (merge reg-a reg-b)"
  ([reg]
   reg)
  ([reg-a reg-b]
   (if (>= (. reg-a ts) (. reg-b ts))
     reg-a
     reg-b))
  ([reg-a reg-b & regs]
   (reduce merge reg-a (cons reg-b regs))))

(defn merge-with
  "Merges registers using custom conflict resolution.
   f is called with [reg-a reg-b] when timestamps equal."
  [f reg-a reg-b]
  (let [ts-a (. reg-a ts)
        ts-b (. reg-b ts)]
    (cond
      (> ts-a ts-b) reg-a
      (> ts-b ts-a) reg-b
      :else (f reg-a reg-b))))

;; ============================================================
;; Query Functions
;; ============================================================

(defn later-than?
  "Returns true if reg-a has later timestamp than reg-b"
  [reg-a reg-b]
  (> (. reg-a ts) (. reg-b ts)))

(defn earlier-than?
  "Returns true if reg-a has earlier timestamp than reg-b"
  [reg-a reg-b]
  (< (. reg-a ts) (. reg-b ts)))

(defn same-timestamp?
  "Returns true if both registers have same timestamp"
  [reg-a reg-b]
  (= (. reg-a ts) (. reg-b ts)))

;; ============================================================
;; Comparison
;; ============================================================

(defn compare-registers
  "Compares two registers.
   Returns:
     1  if reg-a is newer
     0  if timestamps equal
    -1  if reg-a is older"
  [reg-a reg-b]
  (compare (. reg-a ts) (. reg-b ts)))

;; ============================================================
;; Utility Functions
;; ============================================================

(defn copy
  "Creates a copy of register with new timestamp.
   Useful for 'touching' a register to update its timestamp."
  [reg]
  (let [ts (. DateTime :now (millisecondsSinceEpoch))]
    (make-register (. reg value) ts)))

(defn touch
  "Updates register timestamp to now without changing value."
  [reg]
  (copy reg))

(defn reset-timestamp
  "Resets register timestamp to given value"
  [reg ts]
  (make-register (. reg value) ts))

;; ============================================================
;; Serialization Helpers
;; ============================================================

(defn ->map
  "Converts register to map"
  [reg]
  {:id (. reg id)
   :value (. reg value)
   :ts (. reg ts)})

(defn from-map
  "Creates register from map"
  [m]
  (let [id (:id m)
        value (:value m)
        ts (:ts m)]
    (if id
      (->LWWRegister id value ts)
      (make-register value ts))))

(defn ->json
  "Converts register to JSON-compatible map"
  [reg]
  {:value (. reg value)
   :ts (. reg ts)})

;; ============================================================
;; Example Usage
;; ============================================================

(comment

  ;; Create register with timestamp
  (def move-a (lww-register "Windmill" 1000))
  (def move-b (lww-register "Spin Kick" 2000))

  ;; Get value
  (value move-a)
  ;; => "Windmill"

  ;; Merge two registers (later timestamp wins)
  (def merged (merge move-a move-b))
  (value merged)
  ;; => "Spin Kick"

  ;; Create with auto-timestamp
  (def move-c (register "Hurricane"))
  (value move-c)
  ;; => "Hurricane"

  ;; Update with new value
  (def updated (assign move-c "Dragon Kick"))
  (value updated)
  ;; => "Dragon Kick"

  ;; Compare timestamps
  (later-than? move-b move-a)
  ;; => true

  ;; Copy to new timestamp
  (def touched (touch move-a))
  (timestamp touched)
  ;; => current time

  )

;; ============================================================
;; Export Summary
;; ============================================================
;; Factory:
;;   (lww-register value ts)     - Create with timestamp
;;   (register value)            - Create with auto-ts
;;   (register value ts)        - Create with explicit ts
;;   (empty-register)           - Create empty (ts=0)
;;
;; Accessors:
;;   (value reg)                - Get value
;;   (timestamp reg)           - Get timestamp
;;   (register-id reg)         - Get unique id
;;   (timestamped-value reg)   - Get [ts value]
;;
;; Mutation:
;;   (update-register reg v ts) - Update with ts
;;   (assign reg value)         - Assign auto-ts
;;   (copy reg)                - Update timestamp
;;   (touch reg)               - Touch to now
;;   (reset-timestamp reg ts)  - Set timestamp
;;
;; Merge:
;;   (merge reg-a reg-b & regs) - Merge (later wins)
;;   (merge-with f reg-a reg-b) - Custom merge
;;
;; Query:
;;   (later-than? a b)         - a newer than b
;;   (earlier-than? a b)       - a older than b
;;   (same-timestamp? a b)    - equal ts
;;   (compare-registers a b)  - compare
;;
;; Serialization:
;;   (->map reg)               - To map
;;   (from-map m)             - From map
;;   (->json reg)             - To JSON map
;; ============================================================